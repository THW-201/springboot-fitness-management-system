<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fitness.mapper.SocialLikeMapper">

    <select id="checkLike" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM social_like WHERE post_id = #{postId} AND user_id = #{userId}
    </select>

    <select id="getLikeCountByPostId" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM social_like WHERE post_id = #{postId}
    </select>

</mapper>